# Salin jadi .env.local, isi key, lalu restart `npm run dev`.

# Urutan cadangan LLM per agen (nama = awalan variabel di bawah)
GUEST_LLM_ORDER=GROQ,CUSTOM
JUDGE_LLM_ORDER=CUSTOM,GROQ

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=

# Provider custom (endpoint kompatibel OpenAI)
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_API_KEY=

# Speech-to-Text
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
STT_API_KEY=

# Azure Speech (suara tamu + skor pengucapan)
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_KEY=
